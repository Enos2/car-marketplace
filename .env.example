# =============================================================
# Car Marketplace — environment variable reference
# =============================================================
# Copy to backend/.env and fill in real values.
# NEVER commit a real .env file.
# =============================================================

# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Database ----
MONGODB_URI=mongodb://localhost:27017/car-marketplace

# ---- Auth ----
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_ACCESS_EXPIRES=15m
SESSION_SECRET=replace-with-long-random-string
JWT_REFRESH_EXPIRES=7d

# ---- Media storage (S3-compatible) ----
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Email (transactional) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---- Exchange rates ----
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_BASE=USD
EXCHANGE_RATE_TARGET=KES
EXCHANGE_RATE_MAX_AGE_MINUTES=120

# ---- Viewings / Booking ----
VIEWING_REVIEW_WINDOW_HOURS=24
VIEWING_SWEEP_ENABLED=true
VIEWING_SWEEP_INTERVAL_MINUTES=15

# ---- Payment (stub until PayMate integration) ----
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# ---- Receipt signed URLs ----
RECEIPT_SIGNED_URL_SECRET=replace-with-long-random-string
RECEIPT_SIGNED_URL_EXPIRES_MINUTES=30

# ---- Frontend ----
VITE_API_URL=http://localhost:5000/api