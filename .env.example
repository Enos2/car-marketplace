# =========================================================
# Car Marketplace — environment variable reference
# Copy this to backend/.env and fill in real values.
# NEVER commit a real .env file.
# =========================================================

# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Database ----
MONGODB_URI=mongodb://localhost:27017/car-marketplace

# ---- Auth ----
SESSION_SECRET=replace-with-long-random-string
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- Media storage (S3-compatible; leave blank for local disk in dev) ----
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Email (transactional) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---- Exchange rates ----
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_BASE=USD
EXCHANGE_RATE_TARGET=KES
EXCHANGE_RATE_MAX_AGE_MINUTES=120

# ---- Frontend (Vite exposes only vars prefixed with VITE_) ----
VITE_API_URL=http://localhost:5000/api